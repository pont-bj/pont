# Copié en .env par ./setup.sh, qui génère aussi les secrets. Ne jamais committer .env.

# Stockage : postgres (par défaut ; fourni, ou la vôtre via DATABASE_URL) ou convex (installé avec Pont, sans portefeuille)
PONT_STORE=postgres
DATABASE_URL=

PONT_MODE=test
PONT_SANDBOX=true
PONT_PUBLIC_URL=http://localhost:8787

# Ports exposés sur la machine
PONT_PORT=8787
DASHBOARD_PORT=3300
# URL publique du dashboard (à changer derrière un nom de domaine)
DASHBOARD_URL=http://localhost:3300

# Production (./setup.sh --prod) : domaines publics, séparés. Caddy obtient les certificats HTTPS tout seul.
#   PONT_DOMAIN=api.votre-fintech.com           API /v1 et webhooks /hooks (jamais /admin)
#   DASHBOARD_DOMAIN=dashboard.votre-fintech.com
# Ports du proxy (80/443 par défaut ; à changer seulement pour des tests locaux) : CADDY_HTTP_PORT, CADDY_HTTPS_PORT
# PONT_BIND et DASHBOARD_BIND passent à 127.0.0.1 en production : seul le proxy est public.
PONT_DOMAIN=
DASHBOARD_DOMAIN=

# Rôles et authentification de votre fintech
# Modèle de rôles de départ : portefeuille, tontine ou marketplace (modifiables ensuite dans le dashboard)
PONT_ROLES_PRESET=portefeuille
# Inscription publique : laisser vide pour la fermer, ou indiquer le rôle donné aux nouveaux inscrits (ex. client)
PONT_SIGNUP_ROLE=
# URL de votre application (séparées par des virgules) autorisées à appeler l'authentification
PONT_TRUSTED_ORIGINS=

# Clé maître du coffre (générée par setup.sh) : chiffre les clés d'agrégateurs saisies dans le dashboard. La perdre = ressaisir les clés.
PONT_ENCRYPTION_KEY=

# Application qui reçoit les événements Pont (laisser vide pour désactiver)
PONT_WEBHOOK_URL=
PONT_WEBHOOK_SECRET=

# Clés des agrégateurs (sandbox d'abord) : un agrégateur est activé dès que ses variables sont présentes
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_PUBLIC_KEYS=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_WEBHOOK_SECRET=
