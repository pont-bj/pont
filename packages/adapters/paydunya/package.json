{
  "name": "@pont/adapter-paydunya",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "tsup src/index.ts --format esm --dts --clean --target node20"
  },
  "dependencies": {
    "@pont/core": "workspace:*"
  },
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  }
}
