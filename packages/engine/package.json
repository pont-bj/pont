{
  "name": "@pont-bj/engine",
  "version": "0.1.0",
  "description": "Moteur de Pont : orchestration des paiements, vérification et règles de reprise.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --clean --target node20"
  },
  "dependencies": {
    "@pont-bj/core": "workspace:*"
  },
  "devDependencies": {
    "@pont-bj/sandbox": "workspace:*",
    "@pont-bj/adapter-fedapay": "workspace:*",
    "@pont-bj/adapter-pawapay": "workspace:*",
    "@pont-bj/adapter-paydunya": "workspace:*",
    "@pont-bj/adapter-kkiapay": "workspace:*",
    "@pont-bj/adapter-cinetpay": "workspace:*"
  },
  "license": "BUSL-1.1",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "François Mawutô Aboudou ZINSOU <pro@aboudouzinsou.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pont-bj/pont.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/pont-bj/pont#readme",
  "bugs": {
    "url": "https://github.com/pont-bj/pont/issues"
  },
  "keywords": [
    "payments",
    "paiement",
    "mobile-money",
    "byok",
    "africa",
    "benin",
    "xof",
    "fedapay",
    "kkiapay",
    "cinetpay",
    "paydunya",
    "pawapay"
  ]
}
