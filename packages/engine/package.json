{
  "name": "@pont/engine",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --clean --target node20"
  },
  "dependencies": {
    "@pont/core": "workspace:*"
  },
  "devDependencies": {
    "@pont/sandbox": "workspace:*",
    "@pont/adapter-fedapay": "workspace:*",
    "@pont/adapter-pawapay": "workspace:*",
    "@pont/adapter-paydunya": "workspace:*",
    "@pont/adapter-kkiapay": "workspace:*",
    "@pont/adapter-cinetpay": "workspace:*"
  },
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  }
}
