{
  "name": "@pont/mcp",
  "version": "0.1.0",
  "description": "Serveur MCP d'intégration de Pont, pour brancher un assistant IA sur le sandbox.",
  "type": "module",
  "bin": {
    "pont-mcp": "./src/bin.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean --target node20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pont/adapter-cinetpay": "workspace:*",
    "@pont/adapter-fedapay": "workspace:*",
    "@pont/adapter-kkiapay": "workspace:*",
    "@pont/adapter-pawapay": "workspace:*",
    "@pont/adapter-paydunya": "workspace:*",
    "@pont/cli": "workspace:*",
    "@pont/core": "workspace:*",
    "@pont/node": "workspace:*",
    "@pont/sandbox": "workspace:*",
    "zod": "3.25.76",
    "@pont/engine": "workspace:*"
  },
  "license": "BUSL-1.1",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public",
    "bin": {
      "pont-mcp": "./dist/bin.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "author": "François Mawutô Aboudou ZINSOU <pro@aboudouzinsou.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aboudou-cto-bloko/pont.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/aboudou-cto-bloko/pont#readme",
  "bugs": {
    "url": "https://github.com/aboudou-cto-bloko/pont/issues"
  },
  "keywords": [
    "payments",
    "paiement",
    "mobile-money",
    "byok",
    "africa",
    "benin",
    "xof",
    "fedapay",
    "kkiapay",
    "cinetpay",
    "paydunya",
    "pawapay"
  ]
}
