{
  "name": "@pont/recipes",
  "version": "0.1.0",
  "description": "Recettes prêtes à l'emploi pour Pont (par exemple la recette « portefeuille »).",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "license": "BUSL-1.1",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --clean --target node20"
  },
  "dependencies": {
    "@pont/core": "workspace:*",
    "@pont/engine": "workspace:*",
    "@pont/framework": "workspace:*",
    "@pont/ledger": "workspace:*"
  },
  "devDependencies": {
    "@pont/sandbox": "workspace:*",
    "@pont/node": "workspace:*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "author": "François Mawutô Aboudou ZINSOU <pro@aboudouzinsou.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aboudou-cto-bloko/pont.git",
    "directory": "packages/recipes"
  },
  "homepage": "https://github.com/aboudou-cto-bloko/pont#readme",
  "bugs": {
    "url": "https://github.com/aboudou-cto-bloko/pont/issues"
  },
  "keywords": [
    "payments",
    "paiement",
    "mobile-money",
    "byok",
    "africa",
    "benin",
    "xof",
    "fedapay",
    "kkiapay",
    "cinetpay",
    "paydunya",
    "pawapay"
  ]
}
