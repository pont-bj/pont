{
  "name": "@pont-bj/server",
  "version": "0.1.0",
  "type": "module",
  "description": "Serveur Pont autonome (self-host) : API HTTP, webhooks des agrégateurs, planificateur.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "pont-server": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "build": "tsup src/index.ts src/main.ts --format esm --clean --target node20"
  },
  "dependencies": {
    "@pont-bj/core": "workspace:*",
    "@pont-bj/engine": "workspace:*",
    "@pont-bj/framework": "workspace:*",
    "@pont-bj/ledger": "workspace:*",
    "@pont-bj/node": "workspace:*",
    "@pont-bj/recipes": "workspace:*",
    "@pont-bj/store-convex": "workspace:*",
    "@pont-bj/store-prisma": "workspace:*",
    "convex": "1.48.0",
    "nodemailer": "10.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "tsx": "4.19.2"
  },
  "license": "BUSL-1.1",
  "author": "François Mawutô Aboudou ZINSOU <pro@aboudouzinsou.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pont-bj/pont.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/pont-bj/pont#readme",
  "bugs": {
    "url": "https://github.com/pont-bj/pont/issues"
  },
  "keywords": [
    "payments",
    "paiement",
    "mobile-money",
    "byok",
    "africa",
    "benin",
    "xof",
    "fedapay",
    "kkiapay",
    "cinetpay",
    "paydunya",
    "pawapay"
  ],
  "engines": {
    "node": ">=20"
  },
  "private": true
}
