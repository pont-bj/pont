{
  "name": "@pont/store-convex",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./convex/*": "./convex/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --clean --target node20"
  },
  "dependencies": {
    "@pont/core": "workspace:*",
    "@pont/engine": "workspace:*",
    "convex": "1.48.0"
  },
  "devDependencies": {
    "convex-test": "0.0.65",
    "@edge-runtime/vm": "5.0.0",
    "@pont/sandbox": "workspace:*"
  },
  "license": "UNLICENSED",
  "files": [
    "dist",
    "convex"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./convex/*": "./convex/*"
    },
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  }
}
