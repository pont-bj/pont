{
  "name": "@pont-bj/store-convex",
  "version": "0.1.0",
  "description": "Stockage Convex pour Pont.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./convex/*": "./convex/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --dts --clean --target node20"
  },
  "dependencies": {
    "@pont-bj/core": "workspace:*",
    "@pont-bj/engine": "workspace:*",
    "convex": "1.48.0"
  },
  "devDependencies": {
    "convex-test": "0.0.65",
    "@edge-runtime/vm": "5.0.0",
    "@pont-bj/sandbox": "workspace:*"
  },
  "license": "BUSL-1.1",
  "files": [
    "dist",
    "convex",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./convex/*": "./convex/*"
    },
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "François Mawutô Aboudou ZINSOU <pro@aboudouzinsou.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pont-bj/pont.git",
    "directory": "packages/store-convex"
  },
  "homepage": "https://github.com/pont-bj/pont#readme",
  "bugs": {
    "url": "https://github.com/pont-bj/pont/issues"
  },
  "keywords": [
    "payments",
    "paiement",
    "mobile-money",
    "byok",
    "africa",
    "benin",
    "xof",
    "fedapay",
    "kkiapay",
    "cinetpay",
    "paydunya",
    "pawapay"
  ]
}
