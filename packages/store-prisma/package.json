{
  "name": "@pont/store-prisma",
  "version": "0.1.0",
  "description": "Stockage PostgreSQL (Prisma) pour Pont, y compris registre et portefeuilles.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prisma/*": "./prisma/*",
    "./postgres": "./src/postgres.ts"
  },
  "license": "BUSL-1.1",
  "files": [
    "dist",
    "prisma",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "prisma generate && tsc --noEmit -p .",
    "test": "prisma generate && vitest run",
    "generate": "prisma generate",
    "build": "tsup src/index.ts --format esm --dts --clean --target node20"
  },
  "dependencies": {
    "@pont/core": "workspace:*",
    "@pont/engine": "workspace:*",
    "@pont/framework": "workspace:*",
    "@pont/ledger": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./prisma/*": "./prisma/*"
    },
    "access": "public"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "@pont/sandbox": "workspace:*"
  },
  "author": "François Mawutô Aboudou ZINSOU <pro@aboudouzinsou.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aboudou-cto-bloko/pont.git",
    "directory": "packages/store-prisma"
  },
  "homepage": "https://github.com/aboudou-cto-bloko/pont#readme",
  "bugs": {
    "url": "https://github.com/aboudou-cto-bloko/pont/issues"
  },
  "keywords": [
    "payments",
    "paiement",
    "mobile-money",
    "byok",
    "africa",
    "benin",
    "xof",
    "fedapay",
    "kkiapay",
    "cinetpay",
    "paydunya",
    "pawapay"
  ]
}
