{
  "name": "@pont/store-prisma",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prisma/*": "./prisma/*",
    "./postgres": "./src/postgres.ts"
  },
  "license": "UNLICENSED",
  "files": [
    "dist",
    "prisma"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "prisma generate && tsc --noEmit -p .",
    "test": "prisma generate && vitest run",
    "generate": "prisma generate",
    "build": "tsup src/index.ts --format esm --dts --clean --target node20"
  },
  "dependencies": {
    "@pont/core": "workspace:*",
    "@pont/engine": "workspace:*",
    "@pont/framework": "workspace:*",
    "@pont/ledger": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./prisma/*": "./prisma/*"
    },
    "access": "restricted"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "@pont/sandbox": "workspace:*"
  }
}
